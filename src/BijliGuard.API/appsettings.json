{
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=BijliGuard;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Jwt": {
    "Issuer": "BijliGuard",
    "Audience": "BijliGuard.Clients",
    "SigningKey": "SET_IN_USER_SECRETS_MIN_32_CHARS_LONG_KEY",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Otp": {
    "Secret": "SET_IN_USER_SECRETS_MIN_32_CHARS_LONG_SECRET"
  },
  "Email": {
    "Provider": "DevelopmentOutbox",
    "FromAddress": "no-reply@bijliguard.local",
    "FromName": "BijliGuard",
    "OutboxPath": "logs/dev-outbox.txt"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bijliguard-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "AllowedHosts": "*"
}
